{
  "version": 1,
  "purpose": "潮汐线的音频素材账。游戏按 id 引用，build.js 把顶层 wav 内联成 data URI。原始下载与切分前素材在 _source/（不入库）。",
  "created": "2026-11-01",
  "specification": {
    "format": "16bit 单声道 WAV，采样率跟随源文件",
    "norm": "切分时做峰值归一（0.89）或响度归一（RMS 0.10），已加 2~25ms 淡入淡出",
    "rebuild": "node tools/audio-slice.js <源> assets/audio/<id>.wav <起> <止> [--trim=0.05] [--rms=0.10]",
    "license": "Freesound 逐条许可证不同，src 待确认后补"
  },
